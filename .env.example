# Copy this file to .env and edit it. `.env` is ignored by git.

# Who may open the private studio manager (#manager) and with which password.
# Leave PB_ADMIN_PASSWORD empty on first run and the server generates one,
# saving it to server/data/ADMIN-PASSWORD.txt.
PB_ADMIN_EMAIL=pinnaclebuilds1@gmail.com
PB_ADMIN_PASSWORD=

# Port the studio server listens on.
PORT=3000

# Optional: Google sign-in for member accounts (OAuth Web Client ID, no secret).
# Without it, commissions and community posts still work for guests.
# PB_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Optional: force the API URL the served page talks to.
# Defaults to this server's own /api on whatever host you open.
# PB_PUBLIC_API=https://your-site.example.com/api

# Optional: where commissions, builds and uploads are stored.
# PB_DATA_DIR=server/data
